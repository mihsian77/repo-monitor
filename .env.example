# 复制为 .env（仅本地调试用）；正式运行请配置到 GitHub Actions Secrets。
# 严禁把任何真实值写进仓库文件。

# 只读凭证：fine-grained PAT 或 GitHub App installation token。
# 权限只需 Metadata/Contents/Issues/Pull requests/Actions 的 Read-only，绝不赋予写权限。
GH_READ_TOKEN=

# 飞书自定义机器人 Webhook（Webhook 地址本身就是凭证，只放环境变量/Secrets）。
FEISHU_WEBHOOK=

# 可选：飞书机器人开启「签名校验」后填对应密钥；未开启则留空。
# 三条推送通道（主程序 / Worker / 失败告警）都已支持签名。
FEISHU_SECRET=

# 本地运行模式：1 = 只打印不推送、不写 state
DRY_RUN=1

# 可选：Webhook 接收端验签密钥（仅 worker/index.js 使用）
WEBHOOK_SECRET=

# 以下两项通常只在 Actions Secrets 里配置；本机调试时也可写在这里：
# MONITOR_CONFIG：真实仓库清单，一段 JSON 字符串（或改用 config/settings.local.json）
# PRIVACY_SALT：隐私投影盐值，随机生成后固定不变；换了它旧 state 无法还原
